{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "inspect": {
      "type": "object",
      "properties": {
        "requestHeaders": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "tones": {
                    "description": "Value → \"success\", \"warning\" or \"error\", shown as a coloured tag in the popup. Values match case-insensitively; keys like \"2xx\" match status codes.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "success",
                        "warning",
                        "error"
                      ]
                    }
                  },
                  "badge": {
                    "description": "Show the value on the toolbar icon, coloured by its tone: ✓ for success, ⚠ for warning, ✕ for error, and the value itself without a tone. Use an object of value → short text (about 4 characters fit) to show something else for known values.",
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": true
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "minLength": 1
                        },
                        "additionalProperties": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "responseHeaders": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "tones": {
                    "description": "Value → \"success\", \"warning\" or \"error\", shown as a coloured tag in the popup. Values match case-insensitively; keys like \"2xx\" match status codes.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "success",
                        "warning",
                        "error"
                      ]
                    }
                  },
                  "badge": {
                    "description": "Show the value on the toolbar icon, coloured by its tone: ✓ for success, ⚠ for warning, ✕ for error, and the value itself without a tone. Use an object of value → short text (about 4 characters fit) to show something else for known values.",
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": true
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "minLength": 1
                        },
                        "additionalProperties": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "description": "Headers of the current page's document request to show in the popup."
    },
    "clearSiteData": {
      "type": "object",
      "properties": {
        "clear": {
          "default": false,
          "description": "Show a button that clears the current site's cookies and storage, leaving the page as it is.",
          "type": "boolean"
        },
        "clearAndReload": {
          "default": false,
          "description": "Show a button that clears them and reloads the page as a new visitor.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Popup buttons for clearing the current site's data, like DevTools' Clear site data."
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "group": {
            "description": "Profiles sharing a group are mutually exclusive: enabling one disables the others.",
            "type": "string",
            "minLength": 1
          },
          "domains": {
            "description": "Hosts (and their subdomains) to apply to. Omit to apply to all sites.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$"
            }
          },
          "requestHeaders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                },
                "operation": {
                  "default": "set",
                  "type": "string",
                  "enum": [
                    "set",
                    "remove"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "options": {
                  "description": "Label → value presets, shown as a dropdown in the popup. \"value\" defaults to the first one.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "responseHeaders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                },
                "operation": {
                  "default": "set",
                  "type": "string",
                  "enum": [
                    "set",
                    "remove"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "options": {
                  "description": "Label → value presets, shown as a dropdown in the popup. \"value\" defaults to the first one.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "profiles"
  ],
  "additionalProperties": false
}
